# Copy to .env.local. Required variables have a working local value; a module's
# secrets are optional and left blank, and the module says in visible copy that
# it is not switched on until they are set. A module's block starts at its
# `# @module` line and ends at a blank line, and goes when the module is removed.

# The origin every absolute URL is built from: metadata, the sitemap, the
# payment callback. Set it to the real domain in production so nothing is ever
# built from a preview deployment's host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# @module email
# Who mail comes from, e.g. `Weft <hello@example.com>`. Defaults to the site name
# and the contact address in site-config.ts. Leave every transport below blank
# and mail is logged to the server console instead of sent.
EMAIL_FROM=

# @module email-resend
# https://resend.com/api-keys. The From domain must be verified in Resend.
RESEND_API_KEY=

# @module email-smtp
# Any SMTP server. For Gmail: smtp.gmail.com, port 465, the account address, and
# a 16-character App Password (needs 2-step verification on the account).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# @module razorpay
# Dashboard -> Account & Settings -> API Keys. Test keys start rzp_test_, live
# keys rzp_live_; nothing in the code branches on which. The webhook secret is set
# in Settings -> Webhooks -> Add New Webhook, pointing at
# https://<your domain>/api/razorpay/webhook with the event payment.captured.
# All three are required before the site takes money: the webhook is the only
# thing that confirms a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# @module supabase
# Project Settings -> API: the project URL and the publishable key. Both are safe
# in the browser; row level security protects the data, so run
# src/modules/supabase/schema.sql in the SQL editor before going live. For Google
# sign-in, enable the Google provider under Authentication -> Providers and add
# https://<your domain>/auth/callback to Authentication -> URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
