# Copy to .env.local. Required variables have a working local value; a module's
# secrets are optional and left blank, and the module says in visible copy that
# it is not switched on until they are set. `setup.ts` deletes a dropped
# module's block, which starts at its `# @module` line and ends at a blank line.

# The origin every absolute URL is built from: metadata, the sitemap, the
# payment callback. Set it to the real domain in production so nothing is ever
# built from a preview deployment's host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# @module email
# Who mail comes from, e.g. `Weft <hello@example.com>`. Defaults to the site name
# and the contact address in site-config.ts. Leave every transport below blank
# and mail is logged to the server console instead of sent.
EMAIL_FROM=

# @module email-resend
# https://resend.com/api-keys. The From domain must be verified in Resend.
RESEND_API_KEY=

# @module email-smtp
# Any SMTP server. For Gmail: smtp.gmail.com, port 465, the account address, and
# a 16-character App Password (needs 2-step verification on the account).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
