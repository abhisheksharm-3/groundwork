# Copy to .env.local. Required variables have a working local value; a module's
# secrets are optional and left blank, and the module says in visible copy that
# it is not switched on until they are set. `setup.ts` deletes a dropped
# module's block, which starts at its `# @module` line and ends at a blank line.

# The origin every absolute URL is built from: metadata, the sitemap, the
# payment callback. Set it to the real domain in production so nothing is ever
# built from a preview deployment's host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
